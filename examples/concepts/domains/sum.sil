// -*- tab-width:2 ; indent-tabs-mode:nil -*-
//:: case SumDomain
//:: tools silicon
//:: verdict Pass

domain Sum {
    function sum(xs: Seq[Int], lo: Int, hi: Int): Int

    axiom base {
        forall xs: Seq[Int], lo: Int, hi: Int ::
            {sum(xs, lo, hi)}
            lo >= hi ==> sum(xs, lo, hi) == 0
    }

    axiom step {
        forall xs: Seq[Int], lo: Int, hi: Int ::
            {sum(xs, lo, hi)}
            (0 <= lo && lo < hi && hi <= |xs|) ==>
            sum(xs, lo, hi) == xs[lo] + sum(xs, lo + 1, hi)
    }
}

method test(xs: Seq[Int])
    requires |xs| == 5
{
    assert sum(xs, 0, 0) == 0;
    assert sum(xs, 0, 1) == xs[0];
    assert sum(xs, 0, 2) == xs[0] + xs[1];
    assert sum(xs, 0, 3) == xs[0] + xs[1] + xs[2];

    assert sum(xs, 1, 3) == xs[1] + xs[2];

    var s: Int;
    var i: Int;
    s := 0;
    i := 0;

    while (i < |xs|)
        invariant 0 <= i && i <= |xs|
        invariant s == sum(xs, 0, i)
    {
        s := s + xs[i];
        i := i + 1;
    }

    assert s == sum(xs, 0, |xs|);
}
